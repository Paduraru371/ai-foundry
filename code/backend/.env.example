# ============================================================================
# RAG Teaching API — configuration
# Copy to .env and edit. Full step-by-step credential guides: README.md §Credentials
# ============================================================================

# --- server ---------------------------------------------------------------
API_PORT=7799

# --- Qdrant (vector DB — runs in docker; see docker-compose.yml) ----------
# Local run: the compose file maps Qdrant to the rare port 7833.
# Inside docker compose the app overrides this to http://qdrant:6333 automatically.
QDRANT_URL=http://localhost:7833
QDRANT_COLLECTION=libra_rag

# --- chunking defaults (every request may override them) -------------------
# strategies: static | dynamic | sentence | semantic
CHUNK_STRATEGY=dynamic
CHUNK_SIZE=500
CHUNK_OVERLAP=80
SENTENCES_PER_CHUNK=3
SEMANTIC_THRESHOLD=0.75

# --- retrieval / generation defaults ---------------------------------------
TOP_K=4
# Drop weaker cosine matches before they can reach the answer model.
RETRIEVAL_SCORE_THRESHOLD=0.30
# Broad candidate pool for re-ranking; /ask always requests at least 10.
RETRIEVAL_CANDIDATE_POOL=10
# Deterministic pre-ranker: 75% normalized cosine + 25% exact-term coverage.
RETRIEVAL_VECTOR_WEIGHT=0.75
# Jaccard similarity at which a second passage is treated as a duplicate.
RETRIEVAL_DUPLICATE_THRESHOLD=0.82
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2500

# --- PROVIDER SELECTION -----------------------------------------------------
# chat:       lmstudio | openai | anthropic | azure
# embeddings: lmstudio | openai | azure     (Anthropic has no embeddings API)
LLM_PROVIDER=azure
EMBEDDING_PROVIDER=azure

# --- LM Studio (local gemma — free, no account) -----------------------------
# README §Credentials·LM Studio: install → download models → start server on 1234.
# From docker compose use: http://host.docker.internal:1234/v1
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=google/gemma-3-4b
LMSTUDIO_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5

# --- OpenAI -----------------------------------------------------------------
# README §Credentials·OpenAI: platform.openai.com → API keys → create.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (chat only) ---------------------------------------------------
# README §Credentials·Anthropic: console.anthropic.com → API keys → create.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Azure Foundry (the course lane) -----------------------------------------
# README §Credentials·Azure Foundry — endpoint looks like:
#   https://<your-resource>.services.ai.azure.com/models
# AZURE_AI_AUTH=identity → keyless via your `az login` (or managed identity).
# AZURE_AI_AUTH=key      → paste a key below (needed inside docker, where az login
#                          isn't available).
AZURE_AI_ENDPOINT=
AZURE_AI_AUTH=identity
AZURE_AI_API_KEY=
AZURE_AI_CHAT_DEPLOYMENT=gpt-5.1
AZURE_AI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# --- Agents ------------------------------------------------------------------
# local   = the agent loop runs inside this app (works with ANY provider)
# foundry = the agent is hosted by Azure AI Foundry Agent Service (needs Entra auth)
AGENT_MODE=local
AGENT_PERSONA=default
# Foundry portal → your project → Overview → project endpoint
AZURE_AI_PROJECT_ENDPOINT=
# printed by: uv run python scripts/deploy_agent.py <persona>
FOUNDRY_AGENT_ID=

# --- Azure AI Speech (text to speech) -----------------------------------------
# An AIServices ("multi-service") Foundry resource already includes Speech, so you
# usually need NOTHING here: leave both blank and the app reuses AZURE_AI_API_KEY
# with AZURE_LOCATION as the region. Check it with GET /health → speech.
#
# Fill these in only if you created a standalone Speech resource:
#   az cognitiveservices account create -n spch-libra -g <rg> #     --kind SpeechServices --sku S0 -l swedencentral --yes
#   az cognitiveservices account keys list -n spch-libra -g <rg> --query key1 -o tsv
#
# Voice catalogue:  https://speech.microsoft.com/portal/voicegallery
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=en-US-AvaMultilingualNeural
AZURE_SPEECH_LANGUAGE=en-US

# --- Web search & fact checking ------------------------------------------------
# The managed option is "Grounding with Bing Search", a Foundry agent tool. It
# needs a subscription eligible for the Bing SKU — many (trials included) are not,
# and the CLI answers `SkuNotEligible`. So the app also ships a provider-agnostic
# search client:
#
#   auto        try a keyed API if SEARCH_API_KEY is set, else fall back to scraping
#   brave       https://api-dashboard.search.brave.com  → free tier, 2 000 queries/mo
#   serper      https://serper.dev                      → free tier, 2 500 queries
#   duckduckgo  no key; scrapes the HTML endpoint and IS rate-limited/challenged
#
# A key is strongly recommended for a classroom: thirty laptops searching at once
# will trip the keyless path's bot challenge.
SEARCH_PROVIDER=auto
SEARCH_API_KEY=
WEB_SEARCH_RESULTS=5
# How many result pages the fact checker actually downloads and reads.
FACT_CHECK_PAGES=3

# --- Azure AI Search (the managed alternative to the local Qdrant) -------------
# Provision it in one command:  uv run scripts/azure/07-provision-search.ps1
# or by hand:
#   az search service create -n srch-libra-acad -g <rg> --sku basic -l swedencentral
#   az search admin-key show --service-name srch-libra-acad -g <rg> --query primaryKey -o tsv
#
# Leave AZURE_SEARCH_KEY blank to authenticate with your Entra identity instead
# (the service must then have `--auth-options aadOrApiKey` and you need the
# "Search Index Data Contributor" role).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=libra-docs
AZURE_SEARCH_KEY=

# --- Identity inside a container (optional) ----------------------------------
# A container cannot borrow your `az login`, so the compose default is key auth.
# Keys work for chat and embeddings but NOT for the Agent Service or the control
# plane — both require Microsoft Entra.
#
# To give the container a real identity, create a service principal. One script
# creates it, grants it the three roles it needs, and fills in the four lines below:
#
#   cd scripts/azure && ./09-create-service-principal.ps1      # or the .sh
#
# By hand, if you would rather see it happen:
#
#   az ad sp create-for-rbac --name sp-libra-console \
#     --role "Cognitive Services User" \
#     --scopes $(az group show --name <rg> --query id -o tsv)
#
# then paste the three values it prints below and set DOCKER_AZURE_AI_AUTH=identity.
# DefaultAzureCredential tries EnvironmentCredential first, so the code is unchanged.
# Deployed to Azure, the same code uses a managed identity and needs no secret.
DOCKER_AZURE_AI_AUTH=key
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
